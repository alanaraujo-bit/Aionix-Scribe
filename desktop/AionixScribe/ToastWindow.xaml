<Window x:Class="AionixScribe.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="340"
        FontFamily="./Fonts/#Sora">
    <!--
        ShowActivated="False" é obrigatório aqui, não estético: este app existe para inserir texto
        no aplicativo em que a pessoa está trabalhando. Um aviso que rouba o foco mudaria o destino
        do ditado no meio do uso.
    -->
    <Border x:Name="Root" CornerRadius="14" Margin="0,0,0,10"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            Padding="16,14"
            MouseLeftButtonUp="OnClicked"
            Cursor="Hand">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Ellipse x:Name="KindDot" Grid.Column="0" Width="8" Height="8" VerticalAlignment="Top"
                     Margin="0,6,12,0" Fill="{DynamicResource AccentBrush}"/>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" Text="Aionix Scribe" Style="{StaticResource BodyEmphasisTextStyle}"
                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock x:Name="MessageText" Style="{StaticResource BodyMutedTextStyle}" FontSize="12"
                           TextWrapping="Wrap" LineHeight="17"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
