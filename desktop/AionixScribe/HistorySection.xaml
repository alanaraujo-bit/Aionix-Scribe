<UserControl x:Class="AionixScribe.HistorySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AionixScribe"
             FontFamily="./Fonts/#Sora">
    <Grid Margin="28,26,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Histórico" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,4"/>
                <TextBlock Text="Tudo que você ditou, guardado só nesta máquina." Style="{StaticResource TaglineTextStyle}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Limpar histórico" Click="OnClearAllClicked"
                    Style="{StaticResource CompactGhostButtonStyle}" VerticalAlignment="Center"/>
        </Grid>

        <!-- ListBox com container transparente: sem isso o WPF desenha o realce azul nativo de
             seleção por cima dos cards, quebrando a paleta inteira. -->
        <!-- ScrollUnit="Pixel" evita o padrão do WPF de rolar por item inteiro (itens do histórico
             têm alturas diferentes, então isso fazia o scroll parecer engessado); SmoothScroll
             anima cada notch do mouse em vez de saltar direto para o novo offset. -->
        <ListBox x:Name="EntriesList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 local:SmoothScroll.IsEnabled="True"
                 Padding="0,0,4,0">
            <ListBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}"/>
            </ListBox.Resources>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,10">
                        <Border Style="{StaticResource RecentItemShadowStyle}"/>
                        <Border Style="{StaticResource RecentItemContentStyle}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{Binding TimestampDisplay}" Style="{StaticResource FootnoteTextStyle}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Text}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" LineHeight="19"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Copiar" Click="OnCopyClicked" Tag="{Binding Id}"
                                            Style="{StaticResource CompactGhostButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Content="Excluir" Click="OnDeleteClicked" Tag="{Binding Id}"
                                            Style="{StaticResource CompactGhostButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyStateText" Grid.Row="1" Text="Nenhum ditado ainda. Pressione o atalho e fale para começar."
                   Style="{StaticResource BodyMutedTextStyle}" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

        <TextBlock Grid.Row="2" Style="{StaticResource FootnoteTextStyle}" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="15"
                   Text="Armazenado localmente em %LOCALAPPDATA%\AionixScribe\history.json — nada é enviado a servidores além do processamento da própria transcrição. Máximo de 200 itens; os mais antigos são descartados automaticamente."/>
    </Grid>
</UserControl>
