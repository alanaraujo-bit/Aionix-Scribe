<Window x:Class="AionixScribe.MainPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aionix Scribe"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="#14141E"
        Foreground="White"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize">
    <StackPanel Margin="24">
        <TextBlock Text="Aionix Scribe" FontSize="22" FontWeight="Bold" Margin="0,0,0,2"/>
        <TextBlock Text="Falar é uma forma superior de digitar." Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,20"/>

        <Border Background="#1E1E2A" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Ellipse x:Name="MicStatusDot" Width="10" Height="10" Fill="#4ADE80" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="MicStatusText" Text="Microfone pronto" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Atalho: " Foreground="#9CA3AF" FontSize="13"/>
                    <TextBlock x:Name="HotkeyText" Text="—" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Atividade recente" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,8"/>
        <ItemsControl x:Name="RecentList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1E1E2A" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="{Binding TimestampDisplay}" FontSize="10" Foreground="#9CA3AF"/>
                            <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="EmptyRecentText" Text="Nenhum ditado ainda. Pressione o atalho e fale para começar."
                   Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Ver histórico completo" Padding="12,6" Margin="0,0,8,0"
                    Background="#2D2D3D" Foreground="White" BorderThickness="0" Click="OnHistoryClicked"/>
            <Button Content="Configurações" Padding="12,6"
                    Background="#2D2D3D" Foreground="White" BorderThickness="0" Click="OnSettingsClicked"/>
        </StackPanel>
    </StackPanel>
</Window>
