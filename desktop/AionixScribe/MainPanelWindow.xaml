<Window x:Class="AionixScribe.MainPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Aionix Scribe"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="./Fonts/#Sora"
        ResizeMode="CanMinimize"
        Loaded="OnWindowLoaded">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="pack://application:,,,/Assets/AionixScribe.ico" Width="18" Height="18"
                   Margin="14,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Aionix Scribe" VerticalAlignment="Center"
                       Style="{StaticResource TitlebarLabelStyle}"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                <Button x:Name="MinimizeButton" Style="{StaticResource TitlebarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimizeClicked"
                        ToolTip="Minimizar">
                    <TextBlock Text="&#x2013;" FontSize="15"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource TitlebarButtonStyle}" Margin="4,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClicked"
                        ToolTip="Fechar">
                    <TextBlock Text="&#x2715;" FontSize="11"/>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,4,24,24">
            <TextBlock Text="Painel" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,4"/>
            <TextBlock Text="Falar é uma forma superior de digitar." Style="{StaticResource TaglineTextStyle}" Margin="0,0,0,22"/>

            <Grid Margin="0,0,0,16">
                <Border Style="{StaticResource CardShadowStyle}"/>
                <Border Style="{StaticResource CardContentStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse x:Name="MicStatusDot" Width="9" Height="9" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="MicStatusText" Text="Microfone pronto" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Atalho " Style="{StaticResource BodyMutedTextStyle}"/>
                            <TextBlock x:Name="HotkeyText" Text="—" Style="{StaticResource BodyEmphasisTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="ATIVIDADE RECENTE" Style="{StaticResource EyebrowTextStyle}" Margin="4,0,0,10"/>
            <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Border Style="{StaticResource RecentItemShadowStyle}"/>
                            <Border Style="{StaticResource RecentItemContentStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TimestampDisplay}" Style="{StaticResource FootnoteTextStyle}"/>
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource BodyTextStyle}"
                                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyRecentText" Text="Nenhum ditado ainda. Pressione o atalho e fale para começar."
                       Style="{StaticResource BodyMutedTextStyle}" TextWrapping="Wrap" Margin="4,0,0,8" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="Ver histórico completo" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="OnHistoryClicked"/>
                <Button Content="Configurações" Style="{StaticResource GhostButtonStyle}" Click="OnSettingsClicked"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
