<UserControl x:Class="AionixScribe.UsageSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AionixScribe"
             FontFamily="./Fonts/#Sora">
    <Grid Margin="28,26,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Custo de IA" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,4"/>
            <TextBlock Text="Quanto o Aionix Scribe gastou de verdade com a Gemini, chamada por chamada."
                       Style="{StaticResource TaglineTextStyle}"/>
        </StackPanel>

        <!-- Cartões de resumo: cada um é o par Sombra+Conteúdo do CardShadowStyle/CardContentStyle
             (ver comentário desses estilos em Styles.xaml — Effect direto num Border com texto
             engorda o ClearType). -->
        <Grid Grid.Row="1" Margin="0,0,0,16" x:Name="StatsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Border Style="{StaticResource CardShadowStyle}"/>
                <Border Style="{StaticResource CardContentStyle}">
                    <StackPanel>
                        <TextBlock Text="HOJE" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TodayValueText" Text="—" FontFamily="./Fonts/#Sora SemiBold" FontSize="19"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="TodayCallsText" Text="" Style="{StaticResource FootnoteTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="6,0,6,0">
                <Border Style="{StaticResource CardShadowStyle}"/>
                <Border Style="{StaticResource CardContentStyle}">
                    <StackPanel>
                        <TextBlock Text="ESTE MÊS" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="MonthValueText" Text="—" FontFamily="./Fonts/#Sora SemiBold" FontSize="19"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="MonthCallsText" Text="" Style="{StaticResource FootnoteTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="2" Margin="6,0,6,0">
                <Border Style="{StaticResource CardShadowStyle}"/>
                <Border Style="{StaticResource CardContentStyle}">
                    <StackPanel>
                        <TextBlock Text="TOTAL (HISTÓRICO)" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="AllTimeValueText" Text="—" FontFamily="./Fonts/#Sora SemiBold" FontSize="19"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="AllTimeCallsText" Text="" Style="{StaticResource FootnoteTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Só aparece quando GEMINI_MONTHLY_BUDGET_USD está configurado no backend — sem
                 orçamento definido, mostrar "saldo restante" seria inventar um teto que ninguém
                 decidiu (ver pricing.ts). -->
            <Grid Grid.Column="3" Margin="6,0,0,0" x:Name="BudgetCard" Visibility="Collapsed">
                <Border Style="{StaticResource CardShadowStyle}"/>
                <Border Style="{StaticResource CardContentStyle}">
                    <StackPanel>
                        <TextBlock Text="SALDO DO MÊS" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="RemainingValueText" Text="—" FontFamily="./Fonts/#Sora SemiBold" FontSize="19"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="BudgetFootnoteText" Text="" Style="{StaticResource FootnoteTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Carregando…" Style="{StaticResource BodyMutedTextStyle}"
                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Mesmo tratamento de scroll do Histórico (ver SmoothScroll.cs): ScrollUnit="Pixel" porque
             cada linha aqui tem altura fixa, mas o comportamento suave é o mesmo em toda tela com
             lista. -->
        <ListBox x:Name="CallsList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 local:SmoothScroll.IsEnabled="True"
                 Padding="0,0,4,0" Visibility="Collapsed">
            <ListBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}"/>
            </ListBox.Resources>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,8">
                        <Border Style="{StaticResource RecentItemShadowStyle}"/>
                        <Border Style="{StaticResource RecentItemContentStyle}" Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding TimestampDisplay}" Style="{StaticResource FootnoteTextStyle}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding TokensDisplay}" Style="{StaticResource BodyMutedTextStyle}" FontSize="11.5"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding CostDisplay}" Style="{StaticResource BodyEmphasisTextStyle}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" Style="{StaticResource FootnoteTextStyle}" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="15"
                   Text="Custo estimado a partir dos tokens reais que a Gemini reporta em cada chamada, multiplicados pelo preço oficial vigente — não é o extrato oficial de cobrança do Google, mas é calculado com os mesmos números que ele usa. Mostra o uso de todos os dispositivos, não só deste computador."/>
    </Grid>
</UserControl>
