<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- v2 (recalibração pós-feedback "muito cartunizado" + referência real anexada pelo dono:
         fundo quase-branco/creme, texto quase-preto, accent só em detalhes pontuais, botão
         primário PRETO sólido — não a cor de marca). Construído JUNTO com Theme.Dark.xaml desta
         vez, mesma leva de tokens, para nunca mais ficar um tema à frente do outro.

         - Elevação sobe na mesma direção do escuro (card mais claro que a janela) a partir de um
           ponto de partida diferente: janela já quase branca, card vai a branco puro.
         - Cores de estado mais saturadas/escuras que no escuro (pastel perde contraste em fundo
           claro), calibradas por contraste, não só "parecer parecido".
         - MutedTextBrush/FootnoteTextBrush preservam a HIERARQUIA (muted mais proeminente), não os
           valores — no escuro "mais proeminente" = mais claro, no claro = mais escuro.
         - Botão primário claro é preto quase puro com texto claro — ecoa a referência real (Wispr
           Flow usa preto para "Sign in", "Upgrade to Pro" etc., não a cor de marca do produto).
           Accent (roxo/coral) fica para links, ícones de estado e badges pontuais nos dois temas. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FBFAF8"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F1EFEB"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#211F27"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5C596A"/>
    <SolidColorBrush x:Key="FootnoteTextBrush" Color="#8A8794"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#C2551F"/>
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#A6461A"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1FC2551F"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#14211F27"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#24211F27"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>

    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#211F27"/>
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FBFAF8"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#35323D"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#F1EFEB"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#211F27"/>

    <DropShadowEffect x:Key="Elevation1" Color="#211F27" Direction="270" BlurRadius="10" ShadowDepth="2" Opacity="0.10"/>
    <DropShadowEffect x:Key="Elevation2" Color="#211F27" Direction="270" BlurRadius="20" ShadowDepth="6" Opacity="0.14"/>

    <!-- Overlay flutuante aparece sobre QUALQUER janela em foco — precisa continuar legível mesmo
         sobre um navegador ou editor de fundo escuro. Alfa alto pra não se misturar com conteúdo
         por trás; borda visível porque um contorno sutil de "vidro" desaparece fácil sobre
         fundos variados. -->
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#F2FBFAF8"/>
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#4D211F27"/>

</ResourceDictionary>
