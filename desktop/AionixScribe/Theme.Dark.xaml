<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- v2 (recalibração pós-feedback "muito cartunizado"): removido gradiente/glow de botão,
         saturação do accent reduzida, accent virou destaque pontual (não cor de CTA primário —
         primário é neutro de alto contraste, igual à referência). Ver Theme.Light.xaml para o par
         claro construído junto desta vez, não depois. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#18161D"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#211F27"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#2A2830"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F0ED"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#A6A3AC"/>
    <SolidColorBrush x:Key="FootnoteTextBrush" Color="#78757F"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E8763F"/>
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#D9642E"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1FE8763F"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#241005"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#20FFFFFF"/>
    <!-- Contorno de controle interativo (anel de rádio, caixa de seleção). Separado de
         BorderStrongBrush de propósito: aquele delimita superfícies, e no alfa baixo que serve pra
         card um anel de 16px praticamente desaparece — o usuário perde a affordance de "isto é
         clicável e tem estado". Aqui o alfa é deliberadamente mais alto. -->
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>

    <!-- Botão primário: neutro de alto contraste (quase-branco sobre escuro), não a cor de marca —
         é assim que a referência trata seus CTAs principais (pretos no claro). Accent fica pra
         destaques pontuais (badge, link, ícone de estado), nunca pra preencher um botão inteiro. -->
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#F2F0ED"/>
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#18161D"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2A2830"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#F2F0ED"/>

    <!-- Elevação nomeada, deliberadamente discreta (a referência quase não usa sombra) — usar
         Elevation1 como padrão de card; Elevation2 só onde uma superfície precisa parecer
         claramente flutuante (ex.: overlay). Nunca duplicar sombra em cima da sombra nativa que o
         WindowChrome já dá pra janela inteira. -->
    <DropShadowEffect x:Key="Elevation1" Color="Black" Direction="270" BlurRadius="10" ShadowDepth="2" Opacity="0.28"/>
    <DropShadowEffect x:Key="Elevation2" Color="Black" Direction="270" BlurRadius="20" ShadowDepth="6" Opacity="0.35"/>

    <!-- Chrome semi-transparente do overlay flutuante (não são cores de estado de gravação — o
         estado é a cor do StatusDot, ex. SuccessBrush/ErrorBrush). Alfa preservado (8 dígitos).
         Fora do escopo desta calibração — OverlayWindow fica pra depois, valores intocados. -->
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#E6141420"/>
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#332A2A3A"/>

</ResourceDictionary>
