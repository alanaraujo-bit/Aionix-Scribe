<UserControl x:Class="AionixScribe.SettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="./Fonts/#Sora"
             Loaded="OnSectionLoaded" Unloaded="OnSectionUnloaded">
<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
    <ScrollViewer.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}"/>
    </ScrollViewer.Resources>

    <StackPanel Margin="28,26,24,28">
        <TextBlock Text="Configurações" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,4"/>
        <TextBlock Text="Ajuste o atalho, o microfone e o comportamento do app." Style="{StaticResource TaglineTextStyle}" Margin="0,0,0,22"/>

        <!-- ATALHO GLOBAL -->
        <TextBlock Text="Atalho global" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,3"/>
        <TextBlock x:Name="ModeDescriptionText" Text="Pressione o atalho uma vez para começar a ditar, e de novo para parar."
                   Style="{StaticResource BodyMutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Grid Margin="0,0,0,20">
            <Border Style="{StaticResource CardShadowStyle}"/>
            <Border Style="{StaticResource CardContentStyle}">
                <StackPanel>
                    <!-- Badge do atalho em neutro de alto contraste, não em verde: verde é cor
                         de ESTADO (microfone pronto, sucesso). O atalho ativo é informação
                         neutra, e pintá-lo de verde gastava o vocabulário de estado à toa. -->
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                        <TextBlock x:Name="CurrentHotkeyText" Text="Ctrl+Alt+Espaço"
                                   FontFamily="./Fonts/#Sora SemiBold" FontSize="19"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Border>

                    <TextBlock x:Name="StatusText" Style="{StaticResource BodyTextStyle}" FontSize="12"
                               Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                               Margin="0,0,0,12" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ChangeButton" Content="Alterar atalho" Click="OnChangeClicked"
                                Style="{StaticResource CompactGhostButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="ResetButton" Content="Restaurar padrão" Click="OnResetClicked"
                                Style="{StaticResource CompactGhostButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODO DE ATIVAÇÃO -->
        <TextBlock Text="Modo de ativação" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,3"/>
        <TextBlock Text="Como o atalho controla a gravação." Style="{StaticResource BodyMutedTextStyle}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Grid Margin="0,0,0,20">
            <Border Style="{StaticResource CardShadowStyle}"/>
            <Border Style="{StaticResource CardContentStyle}" Padding="6">
                <StackPanel>
                    <RadioButton x:Name="ToggleModeRadio" GroupName="HotkeyMode" Checked="OnModeChanged"
                                 Style="{StaticResource OptionRadioStyle}">
                        <StackPanel>
                            <TextBlock Text="Alternar" Style="{StaticResource BodyEmphasisTextStyle}"/>
                            <TextBlock Text="Pressiona para começar, pressiona de novo para parar."
                                       Style="{StaticResource FootnoteTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="PushToTalkModeRadio" GroupName="HotkeyMode" Checked="OnModeChanged"
                                 Style="{StaticResource OptionRadioStyle}">
                        <StackPanel>
                            <TextBlock Text="Segurar para falar" Style="{StaticResource BodyEmphasisTextStyle}"/>
                            <TextBlock Text="Mantém pressionado enquanto fala, solta para parar."
                                       Style="{StaticResource FootnoteTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Grid>

        <!-- APARÊNCIA -->
        <TextBlock Text="Aparência" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,3"/>
        <TextBlock Text="Tema visual do aplicativo." Style="{StaticResource BodyMutedTextStyle}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Grid Margin="0,0,0,20">
            <Border Style="{StaticResource CardShadowStyle}"/>
            <Border Style="{StaticResource CardContentStyle}" Padding="6">
                <StackPanel>
                    <RadioButton x:Name="SystemThemeRadio" GroupName="ThemePreference" Checked="OnThemeChanged"
                                 Style="{StaticResource OptionRadioStyle}">
                        <StackPanel>
                            <TextBlock Text="Sistema" Style="{StaticResource BodyEmphasisTextStyle}"/>
                            <TextBlock Text="Acompanha o tema claro/escuro do Windows automaticamente."
                                       Style="{StaticResource FootnoteTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LightThemeRadio" GroupName="ThemePreference" Checked="OnThemeChanged"
                                 Style="{StaticResource OptionRadioStyle}">
                        <TextBlock Text="Claro" Style="{StaticResource BodyEmphasisTextStyle}"/>
                    </RadioButton>
                    <RadioButton x:Name="DarkThemeRadio" GroupName="ThemePreference" Checked="OnThemeChanged"
                                 Style="{StaticResource OptionRadioStyle}">
                        <TextBlock Text="Escuro" Style="{StaticResource BodyEmphasisTextStyle}"/>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ÁUDIO -->
        <TextBlock Text="Áudio" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,3"/>
        <TextBlock Text="Microfone usado para gravar o ditado." Style="{StaticResource BodyMutedTextStyle}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Grid Margin="0,0,0,20">
            <Border Style="{StaticResource CardShadowStyle}"/>
            <Border Style="{StaticResource CardContentStyle}">
                <ComboBox x:Name="MicrophoneCombo" SelectionChanged="OnMicrophoneChanged"
                          DisplayMemberPath="Name"
                          Style="{StaticResource SettingsComboBoxStyle}"/>
            </Border>
        </Grid>

        <!-- INICIALIZAÇÃO -->
        <TextBlock Text="Inicialização" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,3"/>
        <TextBlock Text="Controla se o Aionix Scribe abre sozinho ao ligar o Windows."
                   Style="{StaticResource BodyMutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Grid Margin="0,0,0,20">
            <Border Style="{StaticResource CardShadowStyle}"/>
            <Border Style="{StaticResource CardContentStyle}" Padding="6">
                <CheckBox x:Name="StartWithWindowsCheck" Content="Iniciar com o Windows automaticamente"
                          Style="{StaticResource OptionCheckBoxStyle}"
                          Checked="OnStartWithWindowsChanged" Unchecked="OnStartWithWindowsChanged"/>
            </Border>
        </Grid>

        <!-- PRIVACIDADE -->
        <TextBlock Text="Privacidade" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,3"/>
        <TextBlock Text="O que acontece com seus dados." Style="{StaticResource BodyMutedTextStyle}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Grid>
            <Border Style="{StaticResource CardShadowStyle}"/>
            <Border Style="{StaticResource CardContentStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyTextStyle}" FontSize="12" TextWrapping="Wrap"
                               LineHeight="18" Margin="0,0,0,10"
                               Text="O áudio gravado é enviado ao servidor do Aionix Scribe só durante o processamento do ditado (para transcrição via Gemini) e não fica salvo lá — nem em disco, nem em banco de dados. Ele existe apenas no tempo da requisição."/>
                    <TextBlock Style="{StaticResource FootnoteTextStyle}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,14"
                               Text="Guardado localmente nesta máquina, em %LOCALAPPDATA%\AionixScribe\: atalho, modo de ativação e microfone escolhidos, tema de aparência, histórico de ditados (até 200 itens) e gravações pendentes de reprocessamento. Para apagar o histórico de ditados, use o botão &quot;Limpar histórico&quot; na janela de Histórico."/>
                    <Button Content="Abrir pasta de dados" Click="OnOpenDataFolderClicked"
                            Style="{StaticResource CompactGhostButtonStyle}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SOBRE -->
        <TextBlock Text="Sobre" Style="{StaticResource SectionTitleTextStyle}" Margin="0,20,0,3"/>
        <TextBlock Text="Versão instalada e atualizações." Style="{StaticResource BodyMutedTextStyle}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Grid>
            <Border Style="{StaticResource CardShadowStyle}"/>
            <Border Style="{StaticResource CardContentStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Aionix Scribe" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10,5">
                            <TextBlock x:Name="AppVersionText" Text="—" FontFamily="./Fonts/#Sora SemiBold"
                                       FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CheckUpdateButton" Content="Buscar atualizações" Click="OnCheckUpdateClicked"
                                Style="{StaticResource CompactGhostButtonStyle}" Margin="0,0,12,0"/>
                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource BodyMutedTextStyle}"
                                   FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</ScrollViewer>
</UserControl>
