<Window x:Class="AionixScribe.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aionix Scribe — Histórico"
        Width="520" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="#14141E"
        Foreground="White"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Últimos ditados" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <ListBox x:Name="EntriesList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1E1E2A" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding TimestampDisplay}" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Copiar" Padding="10,4" Margin="0,0,8,0"
                                        Background="#2D2D3D" Foreground="White" BorderThickness="0"
                                        Click="OnCopyClicked" Tag="{Binding Id}"/>
                                <Button Content="Excluir" Padding="10,4"
                                        Background="#2D2D3D" Foreground="White" BorderThickness="0"
                                        Click="OnDeleteClicked" Tag="{Binding Id}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyStateText" Grid.Row="1" Text="Nenhum ditado ainda. Pressione o atalho e fale para começar."
                   Foreground="#9CA3AF" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Window>
