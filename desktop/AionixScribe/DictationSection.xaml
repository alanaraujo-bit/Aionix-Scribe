<UserControl x:Class="AionixScribe.DictationSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AionixScribe"
             FontFamily="./Fonts/#Sora">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0" local:SmoothScroll.IsEnabled="True">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}"/>
        </ScrollViewer.Resources>

        <StackPanel Margin="28,26,24,28">
            <TextBlock Text="Ditado" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,4"/>
            <TextBlock Text="Falar é uma forma superior de digitar." Style="{StaticResource TaglineTextStyle}" Margin="0,0,0,22"/>

            <Grid Margin="0,0,0,24">
                <Border Style="{StaticResource CardShadowStyle}"/>
                <Border Style="{StaticResource CardContentStyle}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse x:Name="MicStatusDot" Width="9" Height="9" Fill="{DynamicResource SuccessBrush}"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="MicStatusText" Text="Microfone pronto" VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Atalho " Style="{StaticResource BodyMutedTextStyle}"/>
                                <TextBlock x:Name="HotkeyText" Text="—" Style="{StaticResource BodyEmphasisTextStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12"
                                Padding="16,12" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TotalCountText" Text="0" HorizontalAlignment="Center"
                                           FontFamily="./Fonts/#Fraunces 9pt SemiBold" FontSize="22"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="ditados" HorizontalAlignment="Center" Style="{StaticResource FootnoteTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Text="ATIVIDADE RECENTE" Style="{StaticResource EyebrowTextStyle}" Margin="4,0,0,10"/>
            <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Border Style="{StaticResource RecentItemShadowStyle}"/>
                            <Border Style="{StaticResource RecentItemContentStyle}" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding TimestampDisplay}" Style="{StaticResource FootnoteTextStyle}"/>
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource BodyTextStyle}"
                                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyRecentText" Text="Nenhum ditado ainda. Pressione o atalho e fale para começar."
                       Style="{StaticResource BodyMutedTextStyle}" TextWrapping="Wrap" Margin="4,0,0,8" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
