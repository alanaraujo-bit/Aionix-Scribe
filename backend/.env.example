# Copie para .env local (nunca commitado) ou configure como secret no Railway.

# Obrigatória — chave da Generative Language API (Gemini). Nunca no cliente/instalador.
GEMINI_API_KEY=

# Opcional — alias do modelo Gemini a usar (default: gemini-flash-latest, sempre a versão mais atual)
GEMINI_MODEL=gemini-flash-latest

# Porta HTTP do servidor (Railway injeta automaticamente via PORT)
PORT=3000

# Postgres (Drizzle). Em produção o Railway injeta via referência de variável
# (${{Postgres.DATABASE_URL}}) no serviço aionix-scribe-api — nunca copiar/colar o valor.
# Em dev local, aponte para um Postgres próprio (ex.: postgres://user:pass@localhost:5432/aionix_scribe).
DATABASE_URL=

# Modo do Stripe: test | live (ver backend/src/config/tiers.ts)
STRIPE_MODE=test

# Usados quando a integração de billing for implementada (P3) — não usados no P0
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Limite mensal do plano Essencial em segundos de processamento — indefinido até decisão comercial
ESSENCIAL_MONTHLY_QUOTA_SECONDS=

# Stopgap de autenticação enquanto não existe conta/dispositivo real (P3): o app desktop envia esse
# valor no header X-App-Secret. Não é autenticação de usuário — apenas evita que a URL pública do
# endpoint seja usada por terceiros para queimar cota da Gemini enquanto só o app oficial existe.
DESKTOP_SHARED_SECRET=

# Painel interno de custo (GET /api/admin/gemini-usage, ver backend/src/config/pricing.ts).
# Preço por 1M de tokens em USD — default confirmado na página oficial de pricing da Gemini,
# válido só até 31/12/2026 (o preço sobe depois disso). Deixe em branco para usar o default.
GEMINI_PRICE_INPUT_PER_1M_USD=
GEMINI_PRICE_OUTPUT_PER_1M_USD=

# Teto mensal opcional (USD) para o painel calcular "saldo restante". Deixe em branco para o painel
# mostrar só o gasto, sem orçamento.
GEMINI_MONTHLY_BUDGET_USD=
